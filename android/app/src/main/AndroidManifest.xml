<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- TV app: leanback required, no touchscreen needed -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <uses-feature android:name="android.hardware.wifi" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />

    <!-- A launcher must see every launchable app -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Android requires location permission to disclose the connected SSID.
         No location coordinates or network scanning are requested. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <!-- Optional aerial streams and user-configured Jellyfin connection. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Close app from recents (best-effort; true force-stop lives in App info) -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <!-- Show the system uninstall dialog -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <application
        android:name=".CouchyApplication"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="true"
        android:banner="@drawable/app_banner"
        android:icon="@drawable/app_icon"
        android:label="@string/app_name"
        android:theme="@style/Theme.LiteTV"
        android:supportsRtl="true">
        <activity android:name=".StudioActivity" android:exported="false" android:screenOrientation="landscape" />
        <activity android:name=".AlbumActivity" android:exported="false" android:screenOrientation="landscape" />
        <activity android:name=".AlbumPreviewActivity" android:exported="false" android:screenOrientation="landscape" />
        <service android:name=".AlbumDream" android:exported="true" android:permission="android.permission.BIND_DREAM_SERVICE" android:label="Fotoalbum · výber albumov">
            <intent-filter><action android:name="android.service.dreams.DreamService" /></intent-filter>
        </service>
        <activity android:name=".CrossingActivity" android:exported="false" android:screenOrientation="landscape" />
        <activity android:name=".ScooterActivity" android:exported="false" android:screenOrientation="landscape" />
        <receiver android:name=".RollbackReceiver" android:exported="true" android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="io.github.surzo18.couchytv.RESTORE_V2" />
                <action android:name="io.github.surzo18.couchytv.DISCARD_V2" />
            </intent-filter>
        </receiver>
        <provider android:name="androidx.core.content.FileProvider" android:authorities="${applicationId}.files"
            android:exported="false" android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/shared_paths" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|density|uiMode">

            <!-- Home-screen replacement -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Visible in the stock TV launcher -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- Visible on phone/tablet launchers too (handy for testing) -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Remaps the remote's Google Play button; the user enables it once in
             Accessibility settings (or via adb). -->
        <service android:name=".MediaAccessService" android:exported="true"
            android:label="Couchy · ovládanie prehrávania"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter><action android:name="android.service.notification.NotificationListenerService" /></intent-filter>
        </service>
        <!-- Remaps the remote's Google Play button; the user enables it once in
             Accessibility settings (or via adb). -->
        <service
            android:name=".KeyRemapService"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/key_remap_service" />
        </service>
    </application>
</manifest>
